{
    "version": "0.2.0",
    "configurations": [
      
        {
            "name": "Debug Focusmode",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [],
            "env": {
              "FOCUSMODE_DEBUG": "1"
            },
            "showLog": true
        },
        {
            "name": "Debug Focusmode with args",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": ["--help"],
            "env": {
              "FOCUSMODE_DEBUG": "1"
            },
            "showLog": true
        },
        {
            "name": "Debug Current File",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ]
}
